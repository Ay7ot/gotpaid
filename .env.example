# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL. Used for absolute links, payment callback URLs, emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (project URL from the Supabase dashboard) ──────────────────────
# Public project URL. Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER-ONLY. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Supabase pooler connection string) ────────────────────────────
# Use the TRANSACTION pooler string (port 6543) for serverless/edge workloads.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional: the DIRECT connection string (port 5432) for migrations/seed scripts
# that need to run outside the pooler.
# DATABASE_URL_DIRECT=

# ─── Admin auth ───────────────────────────────────────────────────────────────
# High-entropy secret used to sign the admin session cookie (at least 32 bytes).
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
# payment mode: "mock" (dev) or "paystack"
PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=on@gotpaid.ng
EMAIL_FROM_NAME=GOTPAID

# ─── Storefront ───────────────────────────────────────────────────────────────
# Flat shipping fee in NGN (naira), applied at checkout.
SHIPPING_FEE=3500
# Support WhatsApp number in international format, digits only (e.g. 2348012345678)
SUPPORT_WHATSAPP_NUMBER=
